---
interface Props {
  title: string;
  description: string;
  href: string;
  tags?: string[];
  type?: 'video' | 'article' | 'blog' | 'repo';
  meta?: string;
  external?: boolean;
  thumbnail?: string;
}

const { title, description, href, tags = [], type = 'article', meta, external = false, thumbnail } = Astro.props;

const typeLabels: Record<string, string> = {
  video: 'Video',
  article: 'Article',
  blog: 'Blog Post',
  repo: 'Repository',
};
---
<a
  href={href}
  class:list={['card', { 'card--has-thumb': !!thumbnail }]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-tags={tags.join(',')}
>
  {thumbnail && (
    <div class="card-thumb">
      <img src={thumbnail} alt={title} loading="lazy" />
      {external && (
        <span class="card-external-badge" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </span>
      )}
    </div>
  )}

  <div class="card-body">
    <div class="card-header">
      <span class="card-type">{typeLabels[type]}</span>
      {meta && <span class="card-meta">{meta}</span>}
      {!thumbnail && external && (
        <span class="card-arrow" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </span>
      )}
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>

    {tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="card-tag" data-tag-click={tag}>{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .card:hover {
    border-color: var(--color-text-tertiary);
    box-shadow: 0 4px 16px var(--color-shadow);
    transform: translateY(-2px);
    color: inherit;
  }

  /* Thumbnail */
  .card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .card:hover .card-thumb img {
    transform: scale(1.03);
  }

  .card-external-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
  }

  /* Body */
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .card-type {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .card-meta {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    margin-left: auto;
  }

  .card-arrow {
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    margin-left: var(--space-sm);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .card:hover .card-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    line-height: 1.35;
    color: var(--color-text);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-md);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .card-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2em 0.6em;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast), color var(--transition-fast);
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .card-tag:hover {
    background: var(--color-tag-active-bg);
    color: var(--color-tag-active-text);
  }
</style>

<script>
  function initTagClicks() {
    document.querySelectorAll('[data-tag-click]').forEach((tag) => {
      tag.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const value = (tag as HTMLElement).getAttribute('data-tag-click');
        if (!value) return;

        // Find matching filter button and click it
        const filterBtn = document.querySelector(
          `.filter-btn[data-filter="${value}"]`
        ) as HTMLButtonElement | null;

        if (filterBtn) {
          filterBtn.click();
          // Scroll to the filter bar
          const filterBar = filterBtn.closest('.tag-filter');
          filterBar?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  initTagClicks();
  document.addEventListener('astro:after-swap', initTagClicks);
</script>
